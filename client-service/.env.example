NODE_ENV='dev'
PORT='3000'
FRONTEND_URL='http://localhost:5173'
ENCRYPTION_KEY=''
SALESFORCE_ENCRYPTION_KEY=''

# AWS / DynamoDB Config
AWS_REGION=''
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''

# AWS Athena
AWS_ATHENA_ACCESS_KEY=''
AWS_ATHENA_SECRET_KEY=''

# AWS EventBridge Scheduler
SCHEDULER_ROLE_ARN=''
EVENT_BUS_ARN=''

# JWT Config
JWT_ACCESS_SECRET=''
JWT_REFRESH_SECRET=''
JWT_ACCESS_EXPIRY='15m'
JWT_REFRESH_EXPIRY='7d'

# Salesforce Config
SALESFORCE_CLIENT_ID=''
SALESFORCE_CLIENT_SECRET=''
SALESFORCE_REDIRECT_URI='http://localhost:3000/oauth/callback'
SALESFORCE_WEBHOOK_SECRET=''
# Managed package namespace prefix (e.g. SYX_DVV). Leave empty for an
# unpackaged/scratch org.
SALESFORCE_NAMESPACE=''

# Services
BACKUP_SERVICE='http://localhost:3001/api'
INTERNAL_SECRET=''
# Shared secret the EMR Spark job sends back on every /spark-job/* callback
SPARK_JOB_API_KEY=''

# AWS EMR
AWS_EMR_APPLICATION_ID=''
AWS_EMR_EXECUTION_ROLE_ARN=''
AWS_EMR_ENCRYPTION_KEY=''
AWS_EMR_S3_FILE_PATH=''
# Full spark-submit --conf string submitEMR sends on every job. Must match
# whatever this EMR Serverless application's pre-initialized/maximum capacity
# actually is (see services/payload/index.ts submitEMR) — leave unset to fall
# back to the baseline tuned for 1 driver + 2 executors @ 4 vCPU/16 GB/20 GB
# disk each (12 vCPU maximumCapacity, already fully consumed by initialCapacity).
AWS_EMR_SPARK_SUBMIT_PARAMETERS='--class com.example.Main --conf spark.driver.userClassPathFirst=true --conf spark.executor.userClassPathFirst=true --conf spark.driver.cores=4 --conf spark.driver.memory=13g --conf spark.driver.memoryOverhead=2g --conf spark.driver.maxResultSize=2g --conf spark.emr-serverless.driver.disk=20g --conf spark.executor.cores=4 --conf spark.executor.memory=13g --conf spark.executor.memoryOverhead=2g --conf spark.emr-serverless.executor.disk=20g --conf spark.executor.instances=2 --conf spark.dynamicAllocation.enabled=false --conf spark.memory.fraction=0.6 --conf spark.memory.storageFraction=0.3 --conf spark.serializer=org.apache.spark.serializer.KryoSerializer --conf spark.kryo.registrator=org.apache.spark.HoodieSparkKryoRegistrar --conf spark.kryoserializer.buffer.max=512m --conf spark.hadoop.fs.s3a.impl=org.apache.hadoop.fs.s3a.S3AFileSystem --conf spark.hadoop.fs.s3a.connection.maximum=200 --conf spark.hadoop.fs.s3a.threads.max=64 --conf spark.hadoop.fs.s3a.threads.keepalivetime=60 --conf spark.hadoop.fs.s3a.connection.timeout=60000 --conf spark.hadoop.fs.s3a.connection.establish.timeout=15000 --conf spark.hadoop.fs.s3a.attempts.maximum=5 --conf spark.hadoop.fs.s3a.retry.limit=5 --conf spark.hadoop.fs.s3a.retry.throttle.limit=20 --conf spark.hadoop.fs.s3a.paging.maximum=1000 --conf spark.hadoop.fs.s3a.multipart.size=67108864 --conf spark.hadoop.fs.s3a.block.size=67108864 --conf spark.hadoop.fs.s3a.multipart.threshold=134217728 --conf spark.hadoop.fs.s3a.fast.upload=true --conf spark.hadoop.fs.s3a.fast.upload.buffer=disk --conf spark.hadoop.fs.s3a.fast.upload.active.blocks=4 --conf spark.hadoop.fs.s3a.readahead.range=4194304 --conf spark.network.timeout=600s --conf spark.executor.heartbeatInterval=60s --conf spark.scheduler.mode=FAIR --conf spark.task.cpus=1 --conf spark.locality.wait=0s --conf spark.speculation=false --conf spark.sql.adaptive.enabled=true --conf spark.sql.adaptive.coalescePartitions.enabled=true --conf spark.sql.adaptive.skewJoin.enabled=true --conf spark.sql.shuffle.partitions=128 --conf spark.sql.files.maxPartitionBytes=128m --conf spark.sql.files.openCostInBytes=4m --conf hoodie.embed.timeline.server=true --conf hoodie.metadata.enable=true --conf hoodie.metadata.index.column.stats.enable=false'
# Where submitEMR points EMR's managed S3 log delivery
AWS_EMR_LOGS_S3_URI='s3://qa-data-vault-logs'

# 360 Data Craft (360degreeapps) payment/provisioning API
PAYMENT_API_BASE_URL='https://testingv2.360degreeapps.com/v2/api/v3'
